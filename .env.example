# Copy to .env and fill in with your own values. .env is gitignored.

# Your league and team. Find both in the URL on your ESPN league page:
#   fantasy.espn.com/football/team?leagueId=XXXXXXX&teamId=N
# ESPN_TEAM_ID is 1-based (the same number the URL shows).
ESPN_LEAGUE_ID=
ESPN_TEAM_ID=
ESPN_SEASON=2026

# Only needed for PRIVATE leagues. Many leagues read fine without these —
# try it empty first. To get them: log in to fantasy.espn.com, open DevTools
# (Cmd+Opt+I) -> Application -> Cookies -> https://fantasy.espn.com, and copy
# the values of the "espn_s2" and "SWID" cookies.
ESPN_S2=
SWID=
